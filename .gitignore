# env
.venv/
__pycache__/
*.pyc

# data artifacts (b0 output - too big for git, regenerate via b0.py)
*.bin
meta.json

# HuggingFace dataset cache (if it lands locally)
.cache/

logs/

# in-progress phase bricks - stay local until a brick is FULLY finished.
# Workflow per brick:
#   1. write the brick (local, ignored - invisible to git, can't be added by accident)
#   2. when fully done:   git add -f b<N>.py    (force overrides ignore)
#   3. commit + push that one finished brick.
# Tracked files beat the ignore rule, so once pushed, later edits land normally.
b[0-9]*.py

*_reference.py
probes/
scratch.py

# history via filter-repo; keep it out of git going forward)
PROJECT_SPEC.md
*.bak-*
